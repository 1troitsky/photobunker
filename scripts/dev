#!/bin/sh
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

require_env() {
  if [ ! -f .env ] || [ ! -f apps/api/.env ]; then
    printf '%s\n' 'Run ./scripts/dev setup first.' >&2
    exit 1
  fi
}

compose_down() {
  docker compose -f compose.yaml -f compose.offline.yaml down
}

ensure_network() {
  # Compose versions differ in their handling of changed network settings.
  # Recreate containers/network when switching modes; named volumes survive.
  container=$(docker compose ps --all --quiet postgres)
  if [ -n "$container" ]; then
    network=$(docker inspect --format '{{range $name, $network := .NetworkSettings.Networks}}{{$name}}{{end}}' "$container")
    if [ -n "$network" ]; then
      internal=$(docker network inspect --format '{{.Internal}}' "$network")
      if [ "$internal" != "$1" ]; then
        compose_down
      fi
    fi
  fi
}

case "${1:-help}" in
  setup)
    node scripts/setup-local.mjs
    docker compose config --quiet
    ensure_network false
    docker compose build api
    docker compose pull postgres garage web gateway
    docker compose run --rm --no-deps api composer install --prefer-dist --no-interaction
    docker compose run --rm --no-deps web npm ci --no-fund
    docker compose up -d --wait postgres garage
    docker compose run --rm api php artisan migrate --force
    docker compose run --rm api php artisan photobunker:storage-configure
    docker compose up -d --wait
    printf '%s\n' 'PhotoBunker: http://localhost:8080 or https://photobunker.orb.local'
    ;;
  up)
    require_env
    ensure_network false
    docker compose up -d --wait
    ;;
  down)
    require_env
    compose_down
    ;;
  status)
    require_env
    docker compose ps
    ;;
  check)
    require_env
    docker compose exec -T api php artisan test
    docker compose exec -T api vendor/bin/pint --test
    docker compose exec -T api php artisan photobunker:storage-check --signed
    docker compose exec -T web npm run check
    ;;
  smoke)
    require_env
    node scripts/smoke.mjs
    docker compose exec -T api php artisan photobunker:storage-check --signed
    ;;
  offline)
    require_env
    ensure_network true
    docker compose -f compose.yaml -f compose.offline.yaml up -d --wait --force-recreate
    printf '%s\n' 'Application services now block external egress; Nginx retains host ingress. ./scripts/dev up restores the regular network.'
    ;;
  api)
    require_env
    shift
    docker compose exec -T api "$@"
    ;;
  web)
    require_env
    shift
    docker compose exec -T web "$@"
    ;;
  *)
    printf '%s\n' 'Usage: ./scripts/dev {setup|up|down|status|check|smoke|offline|api <command>|web <command>}'
    ;;
esac
